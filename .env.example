# Copy this file to .env and fill in your values before uploading.
# Run: python generate_config.py

WIFI_SSID=your-wifi-name
WIFI_PASSWORD=your-wifi-password

# Stops to display (one per line, pipe-separated).
# Format A — explicit Leon API fields:
#   label|stopId|lineId|branchHash|destinationFilter|badgeText|badgeColor|badgeMode
# Format B — full Leon screen URL (params are extracted automatically):
#   label|https://departs.leon.gp/screen?screenId=metro&stopId=...&lineId=...&branchHash=...
# Leave branchHash empty to show both directions.
# destinationFilter is optional (substring match on destination labels, e.g. North).
# badgeText and badgeColor are optional (shown in the 28x28 header badge).
#   badgeText   — e.g. E, 206, 1, T1
#   badgeColor  — hex without #, e.g. C04191, 6E491E, FFBE00
#   badgeMode   — bus | rer | metro | tram (optional; inferred from lineId if empty)
#
# Badge label color uses auto WCAG 2.x contrast (RATP/IDFM method):
#   Computes relative luminance for badge background, compares contrast ratio of
#   #FFFFFF vs #25303B (IDFM anthracite, not pure black), picks the higher ratio.
#   bus/rer/metro — contrast against badgeColor
#   tram          — contrast against white center band (#FFFFFF); anthracite wins
#
# Leave badge fields empty to derive color/text from lineId automatically.
# Use || for an empty destinationFilter (e.g. Aller||E|C04191|rer|).
STOP_COUNT=8
STOP_1=Jussieu|fr-idf_IDFM:71148|fr-idf_IDFM:C01103|Retour||67|FF82B4|bus|
STOP_2=Boucicaut|fr-idf_IDFM:412992|fr-idf_IDFM:C01098|Retour||62|6E491E|bus|
STOP_3=Châtelet - Les Halles|fr-idf_IDFM:474151|fr-idf_IDFM:C01742|Aller||A|EB2132|rer|
STOP_4=Château-Thierry|fr-idf_IDFM:411379|fr-idf_IDFM:C01730|Aller||P|F58F53|rer|
STOP_5=Château de Vincennes|fr-idf_IDFM:71634|fr-idf_IDFM:C01371|Aller||1|FFBE00|metro|
STOP_6=Saint-Michel Notre-Dame|fr-idf_IDFM:73620|fr-idf_IDFM:C01374|Aller||4|A0006E|metro|
STOP_7=Cosmonautes|fr-idf_IDFM:73692|fr-idf_IDFM:C01389|Aller||T1|0064B0|tram|
STOP_8=Balard|fr-idf_IDFM:71073|fr-idf_IDFM:C01391|Aller||T3a|F28E42|tram|
